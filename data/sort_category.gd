class_name SortCategory
extends Resource
## Смысловая группа предметов в Sort: «мусор», «уборка», «хранение».
##
## Категория нужна ровно для двух вещей: по ней собирается тройка и по ней
## игрок отличает предметы на глаз. Поэтому здесь только имя и цвет — правил
## у категории нет, они все в SortDefinition.

@export var id: String = ""
@export var display_name: String = ""
## Цвет обводки предмета и его ячейки в лотке. До появления финальных PNG это
## единственное, по чему игрок видит, что три предмета — одна группа.
@export var color: Color = Color(0.85, 0.85, 0.85)
