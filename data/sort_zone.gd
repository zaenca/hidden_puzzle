class_name SortZone
extends Resource
## Закрытый участок поля Sort: ящик, полка, шкафчик — то, внутрь чего сначала
## не залезть.
##
## Зона отличается от обычной блокировки тем, что закрывает не один предмет, а
## место: пока она закрыта, игрок не видит, что в ней лежит, и не может это
## взять. Обычный `blocked_by` для этого не годится — он объясняет «эту вещь
## придавили», а зона говорит «сюда пока нет доступа».
##
## Про то, ящик это или шкафчик, ядро не знает: у зоны есть место на поле,
## список того, что внутри, и список того, что держит её закрытой.

@export var id: String = ""
## Экземпляры внутри. До открытия они недоступны и не нарисованы.
@export var items: PackedStringArray = PackedStringArray()
## Что лежит поверх зоны и держит её закрытой. Пусто — зона открыта сразу
## (валидатор такую считает ошибкой: закрытая зона без замка это просто место).
@export var blocked_by: PackedStringArray = PackedStringArray()
## Место зоны на ИГРОВОМ ПОЛЕ, в его долях. Нужно и чтобы нарисовать закрытую
## зону, и чтобы поймать тап по ней: пока она закрыта, ловить тап больше нечем —
## внутри ничего не нарисовано.
@export var rect: Rect2 = Rect2(0.4, 0.4, 0.2, 0.2)
## Подпись на закрытой зоне. Пусто — без подписи.
@export var label: String = ""
@export var color: Color = Color(0.35, 0.26, 0.17)
