class_name RoomTemplate
extends Resource
## Геометрия комнаты: размеры коробки и камера, которая на неё смотрит.
##
## Шаблон отделён от материалов намеренно. Геометрия — это дорогая настройка:
## её подбирают один раз глазами, и повторять подбор для каждой новой локации
## значит каждый раз заново искать, где встал горизонт. Материалы, наоборот,
## меняются в каждой комнате. Поэтому «medium_room» — один на весь проект, а
## штукатурок в нём может быть сколько угодно.
##
## Камера намеренно без наклона (pitch = 0): при наклоне вертикальные рёбра
## комнаты сходятся, дверь и окно перестают быть вертикальными, и кадр читается
## как 3D-скриншот, а не как нарисованная сцена. Горизонт двигается не наклоном,
## а параметром `horizon` — сдвигом главной точки по экрану.

@export var id: String = ""
@export var title: String = ""

## Длина правой стены от угла, длина левой стены от угла и высота — в условных
## единицах комнаты («метрах»). В них же задаётся размер плитки.
@export var width: float = 4.2
@export var depth: float = 4.2
@export var height: float = 3.0

## Угол раскрытия стен. 45° — прямой угол между стенами, то есть обычная
## прямоугольная комната. Другие значения дают скошенный угол; это осознанная
## степень свободы, а не ошибка.
@export var corner_angle_deg: float = 45.0

## Камера. distance — по оси «от угла к зрителю», eye_height — над полом,
## shift_x — вбок (сдвигает угол комнаты с центра экрана).
@export var cam_distance: float = 5.0
@export var cam_eye_height: float = 1.55
@export var cam_shift_x: float = 0.0
@export var fov_deg: float = 62.0
## Доля высоты экрана, на которой стоит линия горизонта (уровень глаз).
@export var horizon: float = 0.42

## Насколько достроить стены вверх за их высоту, чтобы верх экрана не остался
## пустым. Достройка идёт по той же плоскости, поэтому перспектива и раскладка
## плитки не меняются — просто видно больше стены.
@export var wall_extend_up: float = 2.0


func corner_dirs() -> Array[Vector3]:
	var a := deg_to_rad(corner_angle_deg)
	## Обе стены уходят от угла К ЗРИТЕЛЮ (+Z), расходясь вправо и влево.
	## Именно поэтому угол — самая дальняя точка кадра, а стены к краям экрана
	## становятся выше: они ближе.
	var right := Vector3(sin(a), 0.0, cos(a))
	var left := Vector3(-sin(a), 0.0, cos(a))
	return [right, left]
