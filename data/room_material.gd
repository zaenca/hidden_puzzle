class_name RoomMaterial
extends Resource
## Один материал поверхности из библиотеки `content/room_materials.json`.
##
## Смысл библиотеки — не «слой абстракции ради слоя», а место, где живёт размер
## плитки. Одна и та же штукатурка в трёх комнатах обязана иметь один масштаб:
## если размер писать в каждой комнате заново, кирпич в соседних локациях
## разъедется, и это будет видно.
##
## Пока настоящих PNG нет, материал описывается генератором (`generator`):
## текстура рисуется кодом при первом обращении. Появился PNG — в JSON
## меняется одно поле `texture`, ни один скрипт не трогается.

@export var id: String = ""
@export var category: String = "wall"      ## wall / floor / element / decal / trim
@export var texture_path: String = ""
@export var generator: String = ""         ## имя процедурной заглушки (RoomTextures)
## Размер одной плитки В ЕДИНИЦАХ КОМНАТЫ, а не в пикселях PNG. Число повторов
## считается как «сколько таких плиток укладывается в поверхность», поэтому
## замена PNG 256x256 на PNG 1024x1024 ничего в кадре не двигает.
@export var tile_size: Vector2 = Vector2(1.0, 1.0)
## Габарит предмета в единицах комнаты — для того, что ставят, а не мостят:
## окна, двери, мебели. Шкаф высотой 1.9 остаётся метром девяносто в любой
## комнате, поэтому один и тот же предмет не приходится подгонять под каждый
## шаблон геометрии. Ноль — размер задаёт сам элемент.
@export var size: Vector2 = Vector2.ZERO
@export var tint: Color = Color.WHITE
## Зерно для процедурной заглушки. Отличает две штукатурки друг от друга, когда
## обе рисуются одним генератором.
@export var seed: int = 0


func has_texture() -> bool:
	return not texture_path.is_empty()
