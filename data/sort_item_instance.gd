class_name SortItemInstance
extends Resource
## Один предмет на поле Sort-уровня.
##
## Экземпляр, а не предмет: `item_id` ссылается на ItemDefinition (имя, иконка,
## запасная фигура), а всё остальное — про это конкретное место на этом
## конкретном уровне. Один и тот же item_id может лежать на уровне трижды.

@export var id: String = ""        ## уникален внутри уровня
@export var item_id: String = ""   ## ссылка в items.json
@export var category: String = ""  ## id SortCategory

## Центр предмета, нормализован к ИГРОВОМУ ПОЛЮ уровня, а не к картинке фона.
## Поле — это то, что осталось от экрана после HUD, лотка и safe area, и только
## оно гарантирует, что предмет не уедет под интерфейс на другом соотношении
## сторон. Фон при этом кладётся по обрезке и живёт своей жизнью.
@export var position: Vector2 = Vector2(0.5, 0.5)
## Диаметр предмета в долях ШИРИНЫ поля. Одно число, а не Vector2: предметы
## круглые, и второй размер только позволил бы им разъехаться.
@export var size: float = 0.14
@export var rotation_deg: float = 0.0

## Слой завала. 0 — лежит сверху и доступен сразу. Слой сам по себе ничего не
## запрещает: он только рисует порядок наложения. Запрещает `blocked_by`.
@export var layer: int = 0
## Экземпляры, которые обязаны уйти с поля раньше этого. Пусто — предмет
## доступен с самого начала.
@export var blocked_by: PackedStringArray = PackedStringArray()
