class_name RoomSurfaceConfig
extends Resource
## Чем покрыта одна поверхность комнаты: левая стена, правая стена или пол.
##
## Материал берётся из библиотеки, а всё, что рядом, — необязательные
## переопределения поверх него. Так две комнаты могут стоять на одной и той же
## штукатурке и всё равно выглядеть по-разному: у одной она холодная и мелкая,
## у другой тёплая и крупная.

@export var id: String = ""            ## left_wall / right_wall / floor
@export var material_id: String = ""
@export var texture_path: String = ""  ## прямой путь мимо библиотеки
@export var generator: String = ""     ## процедурная заглушка мимо библиотеки
## Размер плитки в единицах комнаты. Ноль — берём из материала.
@export var tile_size: Vector2 = Vector2.ZERO
## Явное число повторов по поверхности. Заполнено — главнее tile_size. Нужно
## там, где важен ровный счёт («ровно 7 плиток в ширину»), а не их метраж.
@export var repeat: Vector2 = Vector2.ZERO
## Общий множитель к размеру плитки. Быстрый способ «сделать кирпич крупнее»,
## не трогая ни материал, ни число повторов.
@export var tile_scale: float = 1.0
@export var tint: Color = Color.WHITE
## Сдвиг раскладки в долях плитки. Нужен, чтобы шов не приходился ровно в угол
## комнаты или ровно под дверь.
@export var uv_offset: Vector2 = Vector2.ZERO
