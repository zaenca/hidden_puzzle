        { "id": "installed", "label": "",            "hidden": true }
      ]
    },
    {
      "id": "window",
      "rect": [0.170, 0.549, 0.403, 0.147],
      "default": "clean",
      "states": [
        { "id": "dirty", "label": "витрина грязная", "color": "#5a5244cc", "shape": "rect" },
        { "id": "clean", "label": "",                "hidden": true }
      ]
    },
    {
      "id": "door",
      "rect": [0.611, 0.545, 0.208, 0.212],
      "default": "locked",
      "states": [
        { "id": "locked", "label": "", "hidden": true },
        { "id": "open",   "label": "", "color": "#ffd98a55", "shape": "rect" }
      ],
      "interactions": [
        {
          "state": "locked",
          "use_item": "bakery_key",
          "consume": true,
          "set_state": "open",
          "set_flag": "door_open",
          "text": "Ключ со скрипом провернулся в замке. Дверь пекарни открыта."
        },
        {
          "state": "locked",
          "once_flag": "bakery_key_found",
          "grant_item": "bakery_key",
          "text": "Заперто. Под ковриком у порога лежал ключ — он в сумке."
        },
        {
          "state": "locked",
          "text": "Дверь заперта. Возьми ключ в сумке и нажми на дверь."
        },
        {
          "state": "open",
          "text": "Дверь открыта — можно входить."
        }
      ]
    },
    {
      "id": "door_handle",
      "rect": [0.632, 0.645, 0.048, 0.052],
      "default": "installed",
      "states": [
        { "id": "missing",   "label": "", "color": "#2b211a", "shape": "circle" },
        { "id": "installed", "label": "", "hidden": true }
      ]
    },
    {
      "id": "facade_trash",
      "rect": [0.116, 0.750, 0.782, 0.070],
      "default": "cleaned",
      "states": [
        { "id": "dirty",   "label": "мусор у входа", "color": "#6d5f47", "shape": "rect" },
        { "id": "cleaned", "label": "",              "hidden": true }
      ]
    }
